# =============================================================================
# FRONTEND — Node.js / React / Vite / TypeScript
# =============================================================================

frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.cache/

# Environment files (may contain secrets)
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# =============================================================================
# BACKEND — ASP.NET Core / .NET 8
# =============================================================================

backend/**/bin/
backend/**/obj/

# User-specific Visual Studio files
backend/**/*.user
backend/**/*.suo
backend/**/.vs/

# Rider / JetBrains
backend/**/.idea/

# Local secrets — keep appsettings.json (template), ignore local overrides
backend/**/appsettings.Development.json
backend/**/appsettings.Local.json
backend/**/secrets.json

# Published output
backend/**/publish/
backend/**/*.nupkg

# =============================================================================
# DATABASE
# =============================================================================

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# =============================================================================
# OS FILES
# =============================================================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================================================
# IDE / EDITOR
# =============================================================================

# VS Code — ignore user-local settings, keep recommended workspace settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio
.vs/
*.VC.db
*.VC.opendb

# =============================================================================
# TEMPORARY & MISC
# =============================================================================

*.log
*.tmp
*.temp
*.bak
*.swp
*~
